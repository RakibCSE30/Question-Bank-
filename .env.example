# ==============================================================================
# Smart Question Bank - Environment Configuration Template
# Copy this file to .env and fill in real values before running Docker Compose.
# NEVER commit .env or any real secret keys.
# ==============================================================================

# --- App Environment ---
APP_ENV=development
APP_NAME="Smart Question Bank"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_question_bank
POSTGRES_USER=sqb_user
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql+psycopg://sqb_user:change_me_postgres_password@postgres:5432/smart_question_bank

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Qdrant Vector Database ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=document_chunks
QDRANT_COLLECTION_QUESTIONS=question_vectors

# --- Authentication & Security (Generate strong random secrets for prod) ---
JWT_SECRET_KEY=change_me_generate_at_least_32_char_random_hex
JWT_REFRESH_SECRET_KEY=change_me_generate_different_32_char_random_hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_DEFAULT=120/minute

# --- Optional Initial Admin Bootstrap (Leave blank to disable auto-seed) ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Admin

# --- AI / LLM Provider Abstraction ---
# Supported LLM_PROVIDER values: openai (more adapters added in Phase 3)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4.1
GENERATION_TEMPERATURE=0.4
VERIFICATION_MODEL=gpt-4.1
VERIFICATION_TEMPERATURE=0.1

# --- Embedding Provider Abstraction ---
# Supported EMBEDDING_PROVIDER values: openai | sentence_transformers
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
BGE_M3_MODEL=BAAI/bge-m3

# --- Document Ingestion & OCR ---
MAX_UPLOAD_SIZE_MB=25
OCR_LANGUAGES=ben+eng
OCR_QUALITY_THRESHOLD=0.70

# --- Written Evaluation Default Rubric (Total = 100) ---
WRITTEN_RUBRIC_ACCURACY=30
WRITTEN_RUBRIC_RELEVANCE=20
WRITTEN_RUBRIC_STRUCTURE=20
WRITTEN_RUBRIC_CLARITY=15
WRITTEN_RUBRIC_COMPLETENESS=15

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=bn
